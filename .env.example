# Preferred connection setting for hosted databases such as Neon.
DATABASE_URL=

# Local fallback while migrating older setups. DATABASE_URL takes precedence.
DB_NAME=finance_dashboard
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# true resets the synthetic template during bootstrap and isolates each browser.
DEMO_MODE=false
